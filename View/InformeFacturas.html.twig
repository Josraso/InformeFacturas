{% extends "Master/MenuTemplate.html.twig" %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-file-invoice"></i>
                        Informe de Facturas de Venta
                    </h3>
                </div>

                <div class="card-body">
                    <!-- Formulario de filtros -->
                    <form method="post" class="form-horizontal">
                        {{ formToken() }}
                        <input type="hidden" name="action" value="generar">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="fecha_desde" class="form-label">Fecha Desde</label>
                                        <input type="date" class="form-control" id="fecha_desde" name="fecha_desde"
                                               value="{{ fsc.fechaDesde|default('') }}" required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="fecha_hasta" class="form-label">Fecha Hasta</label>
                                        <input type="date" class="form-control" id="fecha_hasta" name="fecha_hasta"
                                               value="{{ fsc.fechaHasta|default('') }}" required>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="serie" class="form-label">Serie</label>
                                        <select class="form-select" id="serie" name="serie">
                                            <option value="">Todas las series</option>
                                            {% if fsc.series is defined %}
                                                {% for serie in fsc.series %}
                                                    <option value="{{ serie.codserie }}"
                                                            {% if serie.codserie == fsc.serieSeleccionada|default('') %}selected{% endif %}>
                                                        {{ serie.codserie }}{% if serie.descripcion is defined and serie.descripcion %} - {{ serie.descripcion }}{% endif %}
                                                    </option>
                                                {% endfor %}
                                            {% endif %}
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="empresa" class="form-label">Empresa</label>
                                        <select class="form-select" id="empresa" name="empresa">
                                            <option value="">Todas las empresas</option>
                                            {% if fsc.empresas is defined %}
                                                {% for empresa in fsc.empresas %}
                                                    <option value="{{ empresa.idempresa }}"
                                                            {% if empresa.idempresa == fsc.empresaSeleccionada|default('') %}selected{% endif %}>
                                                        {{ empresa.nombrecorto|default(empresa.nombre) }}
                                                    </option>
                                                {% endfor %}
                                            {% endif %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="cliente" class="form-label">Cliente</label>
                                <select class="form-select" id="cliente" name="cliente">
                                    <option value="">Todos los clientes</option>
                                    {% if fsc.clientes is defined %}
                                        {% for cliente in fsc.clientes %}
                                            <option value="{{ cliente.codcliente }}"
                                                    {% if cliente.codcliente == fsc.clienteSeleccionado|default('') %}selected{% endif %}>
                                                {{ cliente.codcliente }} - {{ cliente.razonsocial|default(cliente.nombre) }}
                                            </option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                                <small class="form-text text-muted">Pulsa Ctrl+F para buscar en el navegador</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-search"></i> Generar Informe
                                </button>

                                {% if fsc.facturas is defined and fsc.facturas|length > 0 %}
                                    <button type="button" class="btn btn-success me-2" onclick="exportarExcel()">
                                        <i class="fas fa-file-excel"></i> Exportar Excel
                                    </button>

                                    <button type="button" class="btn btn-info" onclick="window.print()">
                                        <i class="fas fa-print"></i> Imprimir
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de resultados -->
    {% if fsc.facturas is defined and fsc.facturas|length > 0 %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-print-block text-center">
                    <h4 class="mb-1">
                        {% if fsc.empresa is defined and fsc.empresa %}
                            {{ fsc.empresa.nombre|default('Empresa') }}
                        {% else %}
                            Empresa
                        {% endif %}
                    </h4>
                    <h5 class="mb-0 text-muted">
                        Facturas de venta del {{ fsc.fechaDesde|default('')|date('d/m/Y') }} al {{ fsc.fechaHasta|default('')|date('d/m/Y') }}, divisa: EUR
                    </h5>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0" id="tablaFacturas">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th style="width: 60px;">SERIE</th>
                                    <th style="width: 100px;">Documento</th>
                                    <th style="width: 80px;">Albarán</th>
                                    <th style="width: 90px;">Fecha</th>
                                    <th style="min-width: 150px;">Cliente</th>
                                    <th style="width: 100px;">CIF/NIF</th>
                                    <th class="text-end" style="width: 80px;">Neto</th>
                                    <th class="text-end" style="width: 60px;">%IVA</th>
                                    <th class="text-end" style="width: 80px;">IVA</th>
                                    <th class="text-end" style="width: 60px;">%RE</th>
                                    <th class="text-end" style="width: 70px;">RE</th>
                                    <th class="text-end" style="width: 80px;">IRPF</th>
                                    <th class="text-end" style="width: 90px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {# OPTIMIZACIÓN: Usar los datos precalculados del controlador #}
                                {% for item in fsc.facturasConIVA %}
                                {% set factura = item.factura %}
                                <tr>
                                    <td>{{ factura.codserie|default('') }}</td>
                                    <td>{{ factura.codigo|default('') }}</td>
                                    <td>{{ factura.codalbaran|default('') }}</td>
                                    <td>{{ factura.fecha|date('d/m/Y') }}</td>
                                    <td title="{{ factura.nombrecliente|default('') }}">
                                        {% set nombreCliente = factura.nombrecliente|default('') %}
                                        {{ nombreCliente|slice(0, 25) }}{% if nombreCliente|length > 25 %}...{% endif %}
                                    </td>
                                    <td>{{ factura.cifnif|default('') }}</td>
                                    <td class="text-end">{{ factura.neto|default(0)|number_format(2, ',', '.') }}</td>
                                    <td class="text-end">{{ item.porcentajeIVA|number_format(0, ',', '.') }}</td>
                                    <td class="text-end">{{ factura.totaliva|default(0)|number_format(2, ',', '.') }}</td>
                                    <td class="text-end">{{ item.porcentajeRE|number_format(2, ',', '.') }}</td>
                                    <td class="text-end">{{ factura.totalrecargo|default(0)|number_format(2, ',', '.') }}</td>
                                    <td class="text-end">{{ factura.totalirpf|default(0)|number_format(2, ',', '.') }}</td>
                                    <td class="text-end"><strong>{{ factura.total|default(0)|number_format(2, ',', '.') }}</strong></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <th colspan="6" class="text-end"><strong>TOTALES:</strong></th>
                                    <th class="text-end"><strong>{{ fsc.totalNeto|default(0)|number_format(2, ',', '.') }}</strong></th>
                                    <th></th>
                                    <th class="text-end"><strong>{{ fsc.totalIVA|default(0)|number_format(2, ',', '.') }}</strong></th>
                                    <th></th>
                                    <th class="text-end"><strong>{{ fsc.totalRecargo|default(0)|number_format(2, ',', '.') }}</strong></th>
                                    <th class="text-end"><strong>{{ fsc.totalIRPF|default(0)|number_format(2, ',', '.') }}</strong></th>
                                    <th class="text-end"><strong>{{ fsc.totalGeneral|default(0)|number_format(2, ',', '.') }}</strong></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="card-footer d-print-none bg-light">
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">
                                <i class="fas fa-calculator"></i> Total de facturas: <strong>{{ fsc.facturas|length }}</strong>
                            </small>
                        </div>
                        <div class="col-md-9 text-end">
                            <strong class="text-primary">
                                <i class="fas fa-info-circle"></i>
                                Neto: {{ fsc.totalNeto|default(0)|number_format(2, ',', '.') }} € |
                                IVA: {{ fsc.totalIVA|default(0)|number_format(2, ',', '.') }} € |
                                Recargo: {{ fsc.totalRecargo|default(0)|number_format(2, ',', '.') }} € |
                                IRPF: {{ fsc.totalIRPF|default(0)|number_format(2, ',', '.') }} € |
                                <span class="text-success">TOTAL: {{ fsc.totalGeneral|default(0)|number_format(2, ',', '.') }} €</span>
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% elseif fsc.fechaDesde is defined and fsc.fechaDesde != '' %}
    <!-- Mensaje cuando no hay resultados -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle fa-2x mb-2"></i>
                <h5>No se encontraron facturas</h5>
                <p class="mb-0">No hay facturas que coincidan con los criterios de búsqueda seleccionados.</p>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
function exportarExcel() {
    if (!validarExportacion()) return;
    enviarFormularioExportacion('exportar_excel');
}

function validarExportacion() {
    {% if fsc.facturas is defined %}
        const facturas = {{ fsc.facturas|length }};
    {% else %}
        const facturas = 0;
    {% endif %}

    if (facturas === 0) {
        alert('No hay facturas para exportar. Genera primero el informe.');
        return false;
    }
    return true;
}

function enviarFormularioExportacion(accion) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '{{ fsc.url() }}';

    // Crear campos ocultos
    const campos = [
        {name: 'action', value: accion},
        {name: 'multireqtoken', value: '{{ formToken(false) }}'},
        {name: 'fecha_desde', value: '{{ fsc.fechaDesde|default("")|e("js") }}'},
        {name: 'fecha_hasta', value: '{{ fsc.fechaHasta|default("")|e("js") }}'},
        {name: 'serie', value: '{{ fsc.serieSeleccionada|default("")|e("js") }}'},
        {name: 'cliente', value: '{{ fsc.clienteSeleccionado|default("")|e("js") }}'},
        {name: 'empresa', value: '{{ fsc.empresaSeleccionada|default("")|e("js") }}'}
    ];

    campos.forEach(function(campo) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = campo.name;
        input.value = campo.value;
        form.appendChild(input);
    });

    document.body.appendChild(form);
    form.submit();
    document.body.removeChild(form);
}

// Validación de fechas
document.addEventListener('DOMContentLoaded', function() {
    const fechaDesde = document.getElementById('fecha_desde');
    const fechaHasta = document.getElementById('fecha_hasta');

    function validarFechas() {
        if (fechaDesde.value && fechaHasta.value) {
            if (fechaDesde.value > fechaHasta.value) {
                fechaHasta.setCustomValidity('La fecha hasta debe ser posterior a la fecha desde');
            } else {
                fechaHasta.setCustomValidity('');
            }
        }
    }

    if (fechaDesde && fechaHasta) {
        fechaDesde.addEventListener('change', validarFechas);
        fechaHasta.addEventListener('change', validarFechas);
    }
});
</script>

<style>
@media print {
    .d-print-none {
        display: none !important;
    }

    .d-print-block {
        display: block !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    .card-header {
        background: none !important;
        border: none !important;
        padding: 10px 0 !important;
    }

    .table {
        font-size: 0.75rem !important;
    }

    .table th,
    .table td {
        padding: 0.25rem !important;
        border: 1px solid #000 !important;
    }

    .table thead th {
        background-color: #f8f9fa !important;
        font-weight: bold !important;
        -webkit-print-color-adjust: exact !important;
        color-adjust: exact !important;
    }

    .table tfoot th {
        background-color: #e9ecef !important;
        font-weight: bold !important;
        -webkit-print-color-adjust: exact !important;
        color-adjust: exact !important;
    }

    .container-fluid {
        max-width: none !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .row {
        margin: 0 !important;
    }

    .col-12 {
        padding: 0 !important;
    }

    body {
        font-size: 12px !important;
    }

    h4, h5 {
        margin: 5px 0 !important;
    }

    .text-end {
        text-align: right !important;
    }

    .text-center {
        text-align: center !important;
    }
}

/* Estilos para pantalla */
@media screen {
    .table-responsive {
        max-height: 70vh;
        overflow-y: auto;
    }

    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .table td {
        white-space: nowrap;
    }

    .table td[title] {
        cursor: help;
    }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .btn {
        border-radius: 0.375rem;
    }

    .form-control, .form-select {
        border-radius: 0.375rem;
    }

    .alert {
        border-radius: 0.5rem;
    }
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .table-responsive {
        font-size: 0.875rem;
    }

    .card-body {
        padding: 1rem;
    }

    .btn {
        margin-bottom: 0.5rem;
        width: 100%;
    }

    .row .col-md-6 {
        margin-bottom: 1rem;
    }
}

/* Loading animation */
.btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

.fa-spin {
    animation: fa-spin 1s infinite linear;
}

@keyframes fa-spin {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}
</style>
{% endblock %}
